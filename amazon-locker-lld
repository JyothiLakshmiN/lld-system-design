    LARGE


import java.time.LocalDateTime;
import java.util.*;


public enum Size {
    SMALL,
    MEDIUM,
    LARGE
}

public class Locker {
    private final List<Compartment> compartments;
    private final Map<String, AccessTocken> accessTokenMapping;

    private static final long TOKEN_VALIDITY_HOURS = 24;

    public Locker(List<Compartment> compartments) {
        this.compartments = compartments;
        this.accessTokenMapping = new HashMap<>();
    }

    public synchronized String depositPackage(Size size) {
        if(Compartment compartment: compartments) {
            if(!compartment.isOccupied() && canFit(compartment.getSize(), size)) {
                compartment.markOccupied();
                String tokenCode = UUID.randomUUID().toString();

                LocalDateTime expiration = LocalDateTime.now().plusHours(TOKEN_VALIDITY_HOURS);

                AccessToken token = new AccessToken(tokenCode, expiration, compartment);
                accessTokenMapping.put(tokenCode, token);
                return tokenCode;
            }
        }

        throw new IllegalStateException("No available compartment for size:" + size);
    }


    private boolean canFit(Size compartmentSize, Size packageSize) {
        return compartmentSize.ordinal() >= packageSize.ordinal();
    }

    public syncronized void pickUp(String tokenCode) {
        AccessToken token = accessTokenMapping.get(tokenCode);

        if(token == null) {
            throw new IllegalArgumentException("Invalid access token");
        }

        if(token.isExpired()) {
            throw new IllegalStateException("Access toke has expired");
        }

        Compartment compartment = token.getCompartment();
        compartment.open();
        compartment.markFree();
        accessTokenMapping.remove(tokenCode);
        System.out.println("Package picked up successfully");
        
    }

    punlic openExpiredCompartments() {
        Iterator<Map.Entry<String, AccessToken>> iterator = accessTokenMapping.entrySet().iterator();

        while(iterator.hasNext()) {
            Map.Entry<String, AccessToken> entry = iterator.next();
            AccessToken token = entry.getValue();

            if(token.isExpired()) {
                Compartment compartment = token.getCompartment();
                compartment.open();
                compartment.markFree();
                iterator.remove();
                System.out.println("Expired component removed from compartment");
            }
        }
    }
}


public class Compartment {
    private final Size size;
    private boolean occupied;

    public Compartment(Size size) {
        this.size = size;
        this.occupied = false;
    }

    public Size getSize() {
        return size;
    }

    public boolean isOccupied() {
        return occupied;
    }

    public void markOccupied() {
        this.occupied = true;
    }

    public void markFree() {
        this.occupied = false;
    }

    public void open() {
        System.out.println("Compartment opened: " + size);
    }
}


import java.time.LocalDateTime;

public class AccessToken {
    private final String code;
    private final LocalDateTime expiration;
    private final Compartment compartment;

    public AccessToken(String code, LocalDateTime expiration,
                       Compartment compartment) {
        this.code = code;
        this.expiration = expiration;
        this.compartment = compartment;
    }

    public boolean isExpired() {
        return LocalDateTime.now().isAfter(expiration);
    }

    public Compartment getCompartment() {
        return compartment;
    }

    public String getCode() {
        return code;
    }

    public LocalDateTime getExpiration() {
        return expiration;
    }
}


import java.util.*;

public class Main {
    public static void main(String[] args) {
        List<Compartment> compartments = Arrays.asList(
                new Compartment(Size.SMALL),
                new Compartment(Size.SMALL),
                new Compartment(Size.MEDIUM),
                new Compartment(Size.LARGE)
        );

        Locker locker = new Locker(compartments);

        // Deposit a medium-sized package
        String token = locker.depositPackage(Size.MEDIUM);
        System.out.println("Access Token: " + token);

        // Pick up the package
        locker.pickup(token);

        // Handle expired packages
        locker.openExpiredCompartments();
    }
}